# Configuração para a HostGator (Apache).

# Sempre usar HTTPS (necessário para instalar no celular e funcionar offline)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Tipos de arquivo
AddType application/manifest+json .webmanifest
AddType application/json .json
AddDefaultCharset utf-8
AddCharset utf-8 .js .css .json .webmanifest

# Compactar textos (a Bíblia fica bem menor para baixar)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# O service worker e a página principal nunca ficam presos em cache antigo
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Segurança básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
Options -Indexes
